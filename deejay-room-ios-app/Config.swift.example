//
//  Config.swift
//  The Deejay Room
//
//  Copy this file to "The Deejay Room Files/Mechanics and Assets/Config.swift"
//  and set baseURL to wherever the backend is running.
//  Config.swift is gitignored, so your local address is never committed.
//
enum Config {
    // iOS Simulator: the backend on the same Mac is reachable at localhost
    static let baseURL = "http://localhost:8080"

    // Physical iPhone: use your Mac's IP address on the same Wi-Fi
    // (find it with `ipconfig getifaddr en0`), e.g.
    // static let baseURL = "http://192.168.1.20:8080"
}
